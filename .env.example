# CaloFit — Örnek Ortam Değişkenleri Yapılandırması (.env.example)

# Uygulama Temel Ayarları
PORT=3000
APP_ENV=development
APP_NAME=CaloFit
APP_URL=http://localhost:3000

# Veri Depolama Yapılandırması
LOCAL_STORAGE_KEY=calofit_app_data_v1
ENABLE_STORAGE_ENCRYPTION=false

# Gelecekteki API Entegrasyonları (Opsiyonel Beslenme / Tarif Veritabanı API)
NUTRITION_API_URL=https://api.edamam.com/api/nutrition-details
NUTRITION_API_KEY=your_api_key_here
NUTRITION_APP_ID=your_app_id_here

# Analitik ve Hata İzleme (Opsiyonel)
ENABLE_ANALYTICS=false
ANALYTICS_TRACKING_ID=UA-000000000-Y
